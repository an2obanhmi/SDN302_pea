generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  readingLogs  ReadingLog[]

  @@map("users")
}

model ReadingLog {
  id          String   @id @default(cuid())
  userId      String
  bookTitle   String
  minutesRead Int      // Chú ý: Đổi từ Float sang Int
  genre       String   // Fiction, Non-Fiction, Sci-Fi, Biography, Other
  note        String   @default("")
  favorite    Boolean  @default(false)
  readOn      String   // YYYY-MM-DD
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readOn])
  @@map("reading_logs")
}
